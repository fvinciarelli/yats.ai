# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === Qdrant ===
QDRANT_URL=http://localhost:6333

# === Embeddings ===
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
EMBEDDING_MISTRAL_API_KEY=
EMBEDDING_MISTRAL_MODEL=mistral-embed
EMBEDDING_VOYAGE_API_KEY=
EMBEDDING_VOYAGE_MODEL=voyage-code-2

# === Repositories ===
REPOSITORIES_PATH=~/repos

# === Logging ===
LOG_LEVEL=info

# === MCP Server ===
MCP_SERVER_PORT=3000
MCP_TRANSPORT=stdio

# === Retriever ===
RETRIEVER_PORT=3001
MAX_VECTOR_HITS=20
MAX_GRAPH_HOPS=1
MAX_TOTAL_RESULTS=30
MAX_TOKENS=8000

# === Indexer ===
INDEXER_PORT=3002
INDEXER_CONCURRENCY=4
MAX_FILE_SIZE_MB=10

# === Optional ===
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://yats:password@localhost:5432/yats

# === E2E tests (optional) ===
# To run the dimension-change E2E test (packages/infra/src/qdrant/qdrant-e2e.test.ts),
# set YATS_E2E=1 and point QDRANT_URL at a THROWAWAY Qdrant instance.
# WARNING: the test deletes and recreates the code + documentation collections.
YATS_E2E=0
# QDRANT_URL=http://localhost:6333
