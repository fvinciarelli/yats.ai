# YATS Benchmark — Agent API keys
#
# The benchmark reads keys from ~/.yats/.env (the same file `yats setup` writes).
# `yats setup` persists the embedding key there; add your agent keys below.
#
#   ~/.yats/.env
#
# Agents and their keys:
#   claude  → ANTHROPIC_API_KEY
#   codex   → OPENAI_API_KEY
#   gemini  → GEMINI_API_KEY
#   copilot → no key — uses `copilot auth` (OAuth), consent asked at start
#   cursor  → no key — uses `cursor-agent login` (OAuth)
#
# If an agent's key is missing, the benchmark will refuse to run it and tell
# you to add it here. Keys are never copied from your real home directory.

# Anthropic API key (for Claude CLI)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key (for Codex CLI)
# https://platform.openai.com/
OPENAI_API_KEY=

# Google API key (for Gemini CLI)
# https://aistudio.google.com/
GEMINI_API_KEY=

# Optional — alternative provider for Codex
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
