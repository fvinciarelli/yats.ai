# YATS Benchmark — API Keys
# Copy this file to .env and fill in your keys.
# Place .env in the directory where you run `yats benchmark`.
#
# Prerequisites:
#   - Python 3.10+ with pip (required for Aider and mcpm-aider bridge)
#   - pip install aider-chat        (Aider agent)
#   - pip install mcpm-aider        (MCP→OpenAI bridge for Aider/Codex)
#   - npm install -g @anthropic-ai/claude-code  (Claude CLI agent)
#   - npm install -g @github/copilot            (Copilot CLI agent)
#   - codex CLI                                 (VS Code Codex agent)

# Anthropic API key (for Claude CLI)
# Get it at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key (for Codex CLI)
# Get it at: https://platform.openai.com/
OPENAI_API_KEY=sk-proj-...

# DeepSeek API key (optional — alternative provider for Codex)
# Get it at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Bridge settings (for agents without native MCP: Aider, Codex)
# Port for the MCP→OpenAI bridge. Default: 8000
# YATS_BRIDGE_PORT=8000
