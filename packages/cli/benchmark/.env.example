# YATS Benchmark — API Keys
# Copy this file to .env and fill in your keys.
# Place .env in the directory where you run `yats benchmark`.

# Anthropic API key (for Claude CLI)
# Get it at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key (for Codex CLI)
# Get it at: https://platform.openai.com/
OPENAI_API_KEY=sk-proj-...

# DeepSeek API key (optional — alternative provider for Codex)
# Get it at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Benchmark model (optional — defaults to haiku)
# Options: haiku, sonnet, opus, fable
YATS_BENCH_MODEL=haiku
