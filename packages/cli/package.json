{
  "name": "@code-indexer/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "code-indexer": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:coverage": "echo 'TODO'"
  },
  "dependencies": {
    "@code-indexer/analyzer-interface": "workspace:^",
    "@code-indexer/analyzer-typescript": "workspace:^",
    "@code-indexer/indexing": "workspace:^",
    "@code-indexer/infra": "workspace:^",
    "@code-indexer/mcp-server": "workspace:^",
    "@code-indexer/retrieval": "workspace:^",
    "@code-indexer/shared": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
