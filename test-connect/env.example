# DeepSeek API key — one key tests claude/codex/copilot/pi model-independently.
# Get it at https://platform.deepseek.com (starts with sk-)
DEEPSEEK_API_KEY=sk-...

# Optional: model name for DeepSeek runs (default: deepseek-v4-pro)
# YATS_TEST_MODEL=deepseek-flash

# Gemini (needs its own key — free at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...

# Cursor (needs account key from cursor.com dashboard — subscription pool)
# CURSOR_API_KEY=...
